[Unit]
Description=NetPulse C++ DNS Forwarding Server
After=network.target packet-streamer.service
Wants=packet-streamer.service

[Service]
Type=simple
User=kali
WorkingDirectory=/home/kali
ExecStart=/home/kali/dns_server -p 53 -u 8.8.8.8 --backend-host 127.0.0.1 --backend-port 3000
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
