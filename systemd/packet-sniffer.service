[Unit]
Description=NetPulse Packet Sniffer HTTP Streamer
After=network.target packet-streamer.service
Wants=packet-streamer.service

[Service]
Type=simple
User=kali
WorkingDirectory=/home/kali
ExecStart=/home/kali/sniffer_http -i any -p 3000
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
